# deploy/kw-dashboard.service
[Unit]
Description=kw-dashboard (Qt/QML) on the HDMI panel
After=network-online.target systemd-logind.service
Wants=network-online.target

[Service]
Type=simple
User=piwi
Group=piwi
SupplementaryGroups=video render input tty
PAMName=login
# Must match where install.sh rsyncs the package to. A mismatch here fails
# with "No module named kw_dashboard" only on a FRESH node, which is exactly
# where nobody is watching — keep these two in step.
WorkingDirectory=/opt/kw-dashboard
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/chvt 2
# Config path must match where install.sh writes it (/etc/kw-dashboard).
ExecStart=/usr/bin/python3 -m kw_dashboard.qt.main --config /etc/kw-dashboard/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
